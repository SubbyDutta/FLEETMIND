{
  "uid": "fleetmind-overview",
  "title": "FleetMind Overview",
  "tags": [
    "fleetmind",
    "kafka",
    "jvm"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Kafka consumer lag (records behind, by consumer group / topic)",
      "description": "kafka_consumer_fetch_manager_records_lag from the client's own fetch manager — no broker-side exporter needed. Flat near 0 = consumers keep up; a climbing line = falling behind (or a stopped consumer).",
      "datasource": {
        "type": "prometheus",
        "uid": "fleetmind-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application, topic) (kafka_consumer_fetch_manager_records_lag)",
          "legendFormat": "{{application}} ← {{topic}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Message throughput (records/sec)",
      "description": "Producer sends vs consumer reads, per service. In steady state the pairs track each other; a gap that persists shows up as lag on the left panel.",
      "datasource": {
        "type": "prometheus",
        "uid": "fleetmind-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application) (rate(kafka_producer_record_send_total[1m]))",
          "legendFormat": "{{application}} produced"
        },
        {
          "refId": "B",
          "expr": "sum by (application) (rate(kafka_consumer_fetch_manager_records_consumed_total[1m]))",
          "legendFormat": "{{application}} consumed"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP server latency p95 / p99",
      "description": "histogram_quantile over http_server_requests_seconds_bucket — requires management.metrics.distribution.percentiles-histogram.http.server.requests=true in each service (that's what publishes the _bucket series).",
      "datasource": {
        "type": "prometheus",
        "uid": "fleetmind-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, application) (rate(http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "{{application}} p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le, application) (rate(http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "{{application}} p99"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "JVM heap (used vs max)",
      "description": "Sawtooth = normal GC breathing. Used creeping toward max with shrinking teeth = memory pressure.",
      "datasource": {
        "type": "prometheus",
        "uid": "fleetmind-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application) (jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "{{application}} used"
        },
        {
          "refId": "B",
          "expr": "sum by (application) (jvm_memory_max_bytes{area=\"heap\"})",
          "legendFormat": "{{application}} max"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "P15 · Redis cache hit rate (per cache)",
      "description": "hits / (hits + misses) over 1m, from cache_gets_total (RedisCacheManager enableStatistics + Micrometer). Climbs toward 1.0 under dashboard load; every hit is a Postgres query that never ran. Flat 0 with traffic = cache broken; no data = nobody is reading that cache.",
      "datasource": {
        "type": "prometheus",
        "uid": "fleetmind-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cache) (rate(cache_gets_total{application=\"command-service\",result=\"hit\"}[1m])) / sum by (cache) (rate(cache_gets_total{application=\"command-service\",result=~\"hit|miss\"}[1m]))",
          "legendFormat": "{{cache}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "P15 · Outbox leader (1 = holds the lease)",
      "description": "outbox_leader gauge, one series per instance_id (host-pid-uuid). Healthy: exactly one series at 1. Kill the leader and watch the crown hop to the other instance within one lease TTL (≤10s). BOTH at 1 = Redis is down and the lease is failing open (efficiency lock: everyone drains, SKIP LOCKED keeps it correct).",
      "datasource": {
        "type": "prometheus",
        "uid": "fleetmind-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "custom": {
            "stepAfter": true
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "outbox_leader",
          "legendFormat": "{{instance_id}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "P20 · GPS pings received vs rows written (per sec)",
      "description": "Batch listener collapses each poll to the latest ping per driver. The gap between the two lines is write amplification removed.",
      "datasource": {
        "type": "prometheus",
        "uid": "fleetmind-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application) (rate(gps_pings_received_total[1m]))",
          "legendFormat": "{{application}} pings received"
        },
        {
          "refId": "B",
          "expr": "sum by (application) (rate(gps_rows_written_total[1m]))",
          "legendFormat": "{{application}} rows written"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "P20 · GPS batch size (avg records per poll)",
      "description": "Under the idle sim this sits near 1. During a flood it should climb toward max-poll-records (500).",
      "datasource": {
        "type": "prometheus",
        "uid": "fleetmind-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application) (rate(gps_batch_size_sum[1m])) / sum by (application) (rate(gps_batch_size_count[1m]))",
          "legendFormat": "{{application}} avg batch"
        },
        {
          "refId": "B",
          "expr": "max by (application) (gps_batch_size_max)",
          "legendFormat": "{{application}} max batch"
        }
      ]
    }
  ]
}
